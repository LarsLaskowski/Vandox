# tests/** is excluded from the cloud analysis (ci.yml, sonar.exclusions), so a rule that only test code violates has no
# cloud finding to mirror: data-driven test methods and sample builders take more than seven parameters on purpose.
[tests/**.cs]
dotnet_diagnostic.S107.severity = none
